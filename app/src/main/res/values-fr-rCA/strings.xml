    <string name="app_name">Fast Magnifier</string>
    <string name="screen_magnifier_service_label">Fast Magnifier — Loupe d’écran</string>
    <string name="screen_magnifier_service_description">Agrandit le contenu affiché par d’autres applications et permet d’extraire le texte visible lorsque vous choisissez Copier le texte.</string>

    <string name="chooser_message">Que voulez-vous agrandir ?</string>
